{
   "name": "@nexus-terminal/frontend",
   "version": "0.9.18",
   "private": true,
   "type": "module",
   "scripts": {
      "dev": "vite --host",
      "build": "vue-tsc --noEmit && vite build",
      "typecheck": "vue-tsc --noEmit",
      "test": "node --experimental-strip-types --test tests/*.test.ts",
      "build:fast": "vite build",
      "preview": "vite preview",
      "debug:eye": "node devtools/eye.mjs",
      "debug:report": "node devtools/eye.mjs --report",
      "debug:mobile": "node devtools/eye.mjs --mobile --report",
      "debug:doctor": "node devtools/eye.mjs --reset --login --report",
      "ai:up": "node devtools/ai.mjs up",
      "ai:state": "node devtools/ai.mjs state"
   },
