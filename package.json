{
  "name": "nexus-terminal",
  "version": "0.9.16",
  "main": "index.js",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "workspaces": [
    "packages/*"
  ],
  "directories": {
    "doc": "doc"
  },
  "scripts": {
    "test": "npm run --prefix packages/frontend test && npm run --prefix packages/backend test",
    "postinstall": "patch-package",
    "desktop:build": "npm run --prefix packages/desktop desktop:build",
    "desktop:build:quick": "npm run --prefix packages/desktop desktop:build:quick",
    "desktop:sync": "npm run --prefix packages/desktop desktop:sync",
    "settings:gen": "node tools/gen-settings-schema.mjs",
    "settings:check": "node tools/gen-settings-schema.mjs --check",
    "i18n:check": "node tools/check-i18n.mjs",
    "check": "npm run typecheck && npm run settings:check && npm run i18n:check && npm test",
    "typecheck": "npm run --prefix packages/backend typecheck && npm run --prefix packages/frontend typecheck"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Heavrnl/nexus-terminal.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Heavrnl/nexus-terminal/issues"
  },
  "homepage": "https://github.com/Heavrnl/nexus-terminal#readme",
  "description": "",
  "dependencies": {
    "axios": "^1.8.4",
    "element-plus": "^2.9.11",
    "fs-extra": "^11.4.1",
    "monaco-editor": "0.52.2",
    "pinia-plugin-persistedstate": "^4.7.1",
    "plist": "^5.0.0",
    "vuedraggable": "^4.1.0",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/speakeasy": "^2.0.10",
    "patch-package": "^8.0.0",
    "qrcode": "^1.5.4",
    "speakeasy": "^2.0.0",
    "sqlite3": "^5.1.7"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "tar": "^7.5.22",
    "on-headers": "^1.1.0",
    "ws": "^8.18.2",
    "uuid": "^11.1.1",
    "multer": "^2.1.0",
    "vite": "^6.4.4",
    "brace-expansion": "^1.1.21",
    "braces": "^3.0.3",
    "@tootallnate/once": "^2.0.1",
    "monaco-editor": "0.52.2"
  }
}
